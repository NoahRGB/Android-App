<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="28dp"
    android:paddingBottom="20dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Shadow Card 2 (Bottom layer) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/shadow_card_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="?attr/cardShadow2Color"
        app:cardCornerRadius="15dp"
        app:cardElevation="0dp"
        android:translationX="16dp"
        android:translationY="-16dp"
        app:layout_constraintTop_toTopOf="@id/main_card"
        app:layout_constraintBottom_toBottomOf="@id/main_card"
        app:layout_constraintStart_toStartOf="@id/main_card"
        app:layout_constraintEnd_toEndOf="@id/main_card" />

    <!-- Shadow Card 1 (Middle layer) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/shadow_card_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="?attr/cardShadow1Color"
        app:cardCornerRadius="15dp"
        app:cardElevation="2dp"
        android:translationX="8dp"
        android:translationY="-8dp"
        app:layout_constraintTop_toTopOf="@id/main_card"
        app:layout_constraintBottom_toBottomOf="@id/main_card"
        app:layout_constraintStart_toStartOf="@id/main_card"
        app:layout_constraintEnd_toEndOf="@id/main_card" />

    <!-- Main Card (Top layer with content) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/main_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/cardBackgroundColor"
        app:cardCornerRadius="15dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageButton
                android:id="@+id/deleteDeckButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Delete deck icon"
                android:scaleType="fitCenter"
                android:src="@drawable/bin"
                app:backgroundTint="@android:color/transparent"
                app:tint="?attr/colorOnSurface"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/deckName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:gravity="center_horizontal"
                android:text="Deck Name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintEnd_toStartOf="@+id/deckCount"
                app:layout_constraintStart_toEndOf="@+id/deleteDeckButton"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/deckDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins"
                android:maxLines="1"
                android:text="######################"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/deckName" />

            <TextView
                android:id="@+id/deckCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="0 cards"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/selectDeckButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Select"
                app:backgroundTint="@color/app_secondary"
                app:cornerRadius="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/deckDescription" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>