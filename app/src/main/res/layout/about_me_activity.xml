<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        tools:context=".AboutMeActivity"
        tools:layout_editor_absoluteX="0dp">

    <ImageButton
        android:id="@+id/closeAboutMeButton"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:contentDescription="Back arrow icon"
        android:scaleType="fitCenter"
        android:src="@drawable/back_arrow"
        app:backgroundTint="@android:color/transparent"
        app:tint="?attr/colorOnSurface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/aboutMeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_black"
            android:text="ABOUT ME"
            android:textColor="@color/app_secondary"
            android:textSize="40sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/closeAboutMeButton"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/aboutMeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/header"
        android:layout_marginTop="16dp"
        tools:context=".AboutMeActivity"
        tools:layout_editor_absoluteX="0dp">

        <ImageView
            android:id="@+id/deck_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/deck_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="30dp"/>

        <TextView
            android:id="@+id/deckCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_black"
            android:text="Decks: 0"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@+id/deck_icon"
            app:layout_constraintTop_toTopOf="@+id/deck_icon"
            app:layout_constraintBottom_toBottomOf="@+id/deck_icon" />

        <ImageView
            android:id="@+id/card_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/flashcard_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/deck_icon"
            android:layout_marginTop="16dp"
            android:layout_marginStart="30dp"/>

        <TextView
            android:id="@+id/cardCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_black"
            android:text="Cards: 0"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@+id/card_icon"
            app:layout_constraintTop_toTopOf="@+id/card_icon"
            app:layout_constraintBottom_toBottomOf="@+id/card_icon" />

        <ImageView
            android:id="@+id/streak_icon"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:src="@drawable/streak"
            app:tint="?attr/colorOnSurface"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_icon"
            android:layout_marginTop="16dp"
            android:layout_marginStart="22dp"/>

        <TextView
            android:id="@+id/streakText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_black"
            android:text="Streak: 0"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@+id/streak_icon"
            app:layout_constraintTop_toTopOf="@+id/streak_icon"
            app:layout_constraintBottom_toBottomOf="@+id/streak_icon" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/moon_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/moon"
        app:tint="?attr/colorOnSurface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aboutMeText"
        android:layout_marginTop="16dp"
        android:layout_marginStart="30dp"/>

    <TextView
        android:id="@+id/darkModeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dark Mode"
        android:fontFamily="@font/poppins_black"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@+id/moon_icon"
        app:layout_constraintTop_toTopOf="@+id/moon_icon"
        app:layout_constraintBottom_toBottomOf="@+id/moon_icon" />

    <Switch
        android:id="@+id/darkModeSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/darkModeLabel"
        app:layout_constraintBottom_toBottomOf="@+id/darkModeLabel" />

</androidx.constraintlayout.widget.ConstraintLayout>